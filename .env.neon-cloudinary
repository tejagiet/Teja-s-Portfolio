# Dedicated Configuration Profile for Cloud Deployment (Neon + Cloudinary)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. NEON SERVERLESS POSTGRESQL DATABASE
# ----------------------------------------------------------------------------
# Step 1: Create a project in https://neon.tech
# Step 2: In Neon Console, go to Connection Details:
#
# A) DATABASE_URL: Choose "Pooled connection" (PgBouncer enabled, port 6543)
#    This pooled connection is used by the Next.js runtime & serverless lambdas.
#    Keep sslmode=require and pgbouncer=true.
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# B) DIRECT_URL: Choose "Direct connection" (Port 5432, no PgBouncer)
#    Prisma CLI requires direct connections for running migrations and DDL locks:
#    `npx prisma migrate deploy`
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ----------------------------------------------------------------------------
# 2. AUTHENTICATION (Auth.js / NextAuth v5)
# ----------------------------------------------------------------------------
# Generate 32 random bytes with: openssl rand -base64 32
# or PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
AUTH_SECRET="REPLACE_WITH_A_SECURE_RANDOM_32_BYTE_STRING"
AUTH_URL="https://tejamanikanta.dev"
NEXTAUTH_URL="https://tejamanikanta.dev"
NEXT_PUBLIC_SITE_URL="https://tejamanikanta.dev"

# ----------------------------------------------------------------------------
# 3. INITIAL ADMIN BOOTSTRAP
# ----------------------------------------------------------------------------
# For one-time web setup at /admin/setup, set a token:
ADMIN_SETUP_TOKEN="REPLACE_WITH_RANDOM_LONG_SECRET_TOKEN"
# Or for programmatic seed with `npm run db:seed`:
ADMIN_EMAIL="admin@tejamanikanta.dev"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"
ADMIN_NAME="Teja Manikanta"

