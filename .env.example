# ============================================================================
# Teja Manikanta Portfolio - Environment configuration
# Copy this file to .env (local) or set these values in Vercel.
# NEVER commit real credentials.
# ============================================================================

# Neon PostgreSQL connection strings:
# 1. DATABASE_URL: Neon dashboard -> Connection Details -> "Pooled connection" (port 6543) with pgbouncer.
#    Used by Next.js serverless functions to avoid connection exhaustion.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15"
# 2. DIRECT_URL: Neon dashboard -> Connection Details -> "Direct connection" (port 5432).
#    Used by Prisma CLI for migrations (`npx prisma migrate deploy` / `dev`).
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="https://your-domain.com"
NEXTAUTH_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# One-time initial admin setup.
# Create the first admin at /admin/setup using this token, then remove the token.
ADMIN_SETUP_TOKEN=""
# Optional: used by `npm run db:seed` to create the initial admin directly.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Teja Manikanta"

# Cloudinary media storage (required in production).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="teja-portfolio"

# Optional transactional email via Resend.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_NOTIFICATION_EMAIL=""

# Optional Google PageSpeed Insights API key for the SEO audit panel.
PAGESPEED_API_KEY=""

# Salt for hashing visitor IPs (rate limiting / abuse protection).
IP_HASH_SALT=""
ANALYTICS_SALT=""
